<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Advantis IoT Module - Simplified Integration"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#2196F3"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lightweight IoT monitoring for Android apps"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="#666"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Ready to start IoT monitoring"
        android:textSize="14sp"
        android:background="#E3F2FD"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:drawableStart="@android:drawable/ic_menu_info_details"
        android:drawablePadding="8dp"
        android:textColor="#1976D2" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/data_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Real-time IoT data will appear here...\n\n🔥 Fire Detection: Waiting for data\n🪟 Window Status: Waiting for data\n💡 Lights Status: Waiting for data\n🔗 Connection: Not started"
            android:textSize="13sp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:fontFamily="monospace"
            android:textColor="#333"
            android:elevation="2dp" />

    </ScrollView>

    <!-- Main Action Button -->
    <Button
        android:id="@+id/btn_launch_monitoring"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚀 Launch IoT Monitoring Dashboard"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="16dp" />

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_start_monitoring"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶️ Start\nMonitoring"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_stop_monitoring"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏹️ Stop\nMonitoring"
            android:layout_marginStart="6dp"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Info Button -->
    <Button
        android:id="@+id/btn_get_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 Get Current IoT State"
        android:backgroundTint="#9C27B0"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

</LinearLayout>